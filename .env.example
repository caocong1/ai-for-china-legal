# ============================================================
# AI for China Legal — Environment Variables
# Copy this file to .env and fill in actual values.
# ============================================================

# --- 裁判文书网 (wenshu) ---
# 浏览器自动化连接器（playwright-core + 本机 Chrome）；检索需登录，
# 登录方式：node connectors/wenshu/login.js（打开可见窗口，本人支付宝扫码，一次即可）
# WENSHU_PROFILE_DIR=   # 浏览器会话目录（含登录 Cookie，敏感），默认 ~/.cache/com.sorawatcher.inkstatute/wenshu-profile

# --- 人民法院案例库 (rmfyalk) ---
# 浏览器持久会话 + 站内 JSON API；检索/详情需登录（共道统一认证），收录统计匿名可用，
# 登录方式：node connectors/rmfyalk/login.js（打开可见窗口，本人完成共道账号登录，一次即可）
# RMFYALK_PROFILE_DIR=  # 浏览器会话目录（含登录 Cookie，敏感），默认 ~/.cache/com.sorawatcher.inkstatute/rmfyalk-profile

# --- 企业信用信息公示系统 (gsxt) ---
GSXT_API_URL=https://www.gsxt.gov.cn/api
GSXT_API_KEY=

# --- 国家法律法规数据库 (law-database) ---
LAW_DB_API_URL=https://flk.npc.gov.cn/api
LAW_DB_API_KEY=
LAW_DB_TIMEOUT_MS=30000
LAW_DB_MAX_RETRIES=3
LAW_DB_CACHE_TTL_SECONDS=86400

# --- 元典开放平台 (yuandian) ---
# 定位：兜底/最后选择（按调用计点；赠送积分 2026-09 到期后不再续费，届时留空即可）
# 可选：不配置时，首次调用会提示向用户索取 API Key 并临时保存到系统临时目录
YUANDIAN_API_KEY=
YUANDIAN_BASE_URL=https://open.chineselaw.com
YUANDIAN_TIMEOUT_MS=30000

# --- 企业微信/钉钉通知 (wechat-notify) ---
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=

# --- 商标查询 (trademark) ---
TRADEMARK_API_URL=https://sbj.cnipa.gov.cn/api
TRADEMARK_API_KEY=

# --- 专利查询 (patent) ---
PATENT_API_URL=https://pss-system.cnipa.gov.cn/api
PATENT_API_KEY=

# --- 案件管理系统 ---
CASE_MANAGEMENT_API_URL=
CASE_MANAGEMENT_API_KEY=

# --- 通知渠道 ---
NOTIFICATION_CHANNEL=wechat

# --- Agent 自定义参数 ---
# CASE_MONITOR_KEYWORDS=["买卖合同","劳动争议","竞业限制"]
# REGULATION_MONITOR_REGIONS=["北京","上海","广东","浙江"]
# MONITORED_COMPANIES=[{"name":"示例公司","code":"91110108XXXXXXXXXX"}]
# DEADLINE_URGENT_DAYS=3
# DEADLINE_IMPORTANT_DAYS=7
# DEADLINE_NORMAL_DAYS=30
